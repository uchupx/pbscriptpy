Profile (JSON file - profiles.json):
  name: str
  mode: "sniper" | "ar_smg" | "shotgun"
  trigger: "lclick" | "xbutton1" | "xbutton2"
  sniper_delays: list[int] (4 values, 0-200ms)
  shotgun_delays: list[int] (2 values, 0-200ms)
  ar_smg_delay: int (0-200ms)
  switch_method: "qq" | "31"
  key_hold_delay: int (0-200ms)
  recoil: bool
  recoil_amount: int (1-20)
  recoil_smooth: bool
  recoil_timeout_ms: int (500-3000)

Engine State (engine/_state.py, module-level globals):
  _listening, _running, _trigger_held: bool
  _stop_macro: threading.Event
  _cfg: dict (runtime copy of config.DEFAULT)
  _hook, _hook_proc, _hook_thread, _hook_thread_id
  _macro_thread: Thread
  _pb_hwnd, _trigger_blocked
  _log_callback, _status_callback, _action_callback: callable
  _shortcut_running: bool
  _shortcut_prev: dict (vk → bool debounce)

App State (app/action_handlers.py, module-level):
  _selected_delay_slot: int
  _selected_recoil, _selected_timeout: bool
  _last_action, _last_action_time: debounce

ActionQueue (thread-safe, app/action_handlers.py):
  action: str
  data: dict

Toast (app/toast.py):
  window: tkinter.Toplevel
  position: screen top-left (+10+10)
  duration: 2500ms
  alpha: 0.85
  font: Consolas 10 bold

Layer Dependency:
  app/ → imports → engine/
  engine/ never imports app/
