pbscriptpy/
├── main.py                    # Shim: `python main.py` → app.__main__
├── requirements.txt
├── profiles.json              # Runtime data (auto-saved in ~/Documents/pbscriptpy/)
├── .gitignore
├── .gitattributes
│
├── engine/                    # Core engine — platform-agnostic API
│   ├── __init__.py
│   ├── config.py              # DEFAULT settings dict
│   ├── _state.py              # Shared globals + public API (set_config, etc.)
│   ├── input_sim.py           # Dispatcher: click_left/right, mouse_move, press_key, _wait
│   ├── hook.py                # Dispatcher: start/stop_listener, trigger block
│   ├── shortcuts.py           # Dispatcher: start/stop_shortcut_polling
│   ├── macros.py              # Macro sequences (sniper/shotgun/ar_smg) — platform-agnostic
│   ├── _plat_win32.py         # Windows: ctypes SendInput + WH_MOUSE_LL + GetAsyncKeyState
│   └── _plat_linux.py         # Linux: ydotool + evdev polling
│
├── app/                       # tkinter layer
│   ├── __init__.py
│   ├── __main__.py            # Entry: wire UI + engine, start mainloop
│   ├── ui.py                  # Widget creation (build_ui → root + refs)
│   ├── profiles.py            # Profile CRUD, persistence, UI callbacks
│   ├── toast.py               # Toast overlay Toplevel
│   └── action_handlers.py     # Keyboard shortcut handlers + queue polling
│
├── docs/
│   └── superpowers/specs/     # Design documents
│
└── .agents/                   # Metadata
